# Safe template only. Copy server values to the ignored .env.local file.
FLEET_BROKER_HOST=0.0.0.0
FLEET_BROKER_PORT=8787
FLEET_MASTER_TOKEN=replace-with-a-random-token
FLEET_TRACKER_TOKEN=replace-with-a-different-random-token
FLEET_TLS_PASSPHRASE=replace-with-certificate-passphrase
FLEET_LOCATION_KEY=replace-with-random-base64-32-byte-key
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=your-admin-chat-id
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-the-server-only-service-role-key
VITE_BROKER_URL=wss://your-public-host.example/ws

# Android app builds use separate ignored role files to avoid sharing device tokens:
# .env.tracker.local      -> VITE_DEVICE_TOKEN=<unique tracker token>
# .env.master-live.local  -> VITE_DEVICE_TOKEN=<unique master token>
# Never copy a service-role key into a VITE_* variable or commit real credentials.
